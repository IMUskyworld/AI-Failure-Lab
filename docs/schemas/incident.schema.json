    "reproduction": {
      "$ref": "#/$defs/Reproduction"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "medium"
    },
    "signature": {
      "default": "",
      "title": "Signature",
      "type": "string"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "source": {
      "default": "import",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus",
      "default": "open"
    },
    "task": {
      "default": "",
      "title": "Task",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "traces": {
      "items": {
        "type": "string"
      },
      "title": "Traces",
      "type": "array"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "public_id",
    "slug",
    "title",
    "created_at",
    "updated_at"
