    "Backend": {
      "enum": [
        "llm",
        "offline"
      ],
      "title": "Backend",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "reproduced",
        "fixed",
        "wontfix"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "ReproSpec": {
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "expect_exit_nonzero": {
          "default": true,
          "title": "Expect Exit Nonzero",
          "type": "boolean"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "timeout_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "required": [
        "command"
      ],
      "title": "ReproSpec",
      "type": "object"
    },
    "ReproStatus": {
      "enum": [
        "unverified",
        "reproduced",
        "fixed",
        "inconclusive",
        "interrupted"
      ],
      "title": "ReproStatus",
      "type": "string"
    },
    "Reproduction": {
      "properties": {
        "fixed_count": {
          "default": 0,
          "title": "Fixed Count",
          "type": "integer"
        },
        "inconclusive_count": {
          "default": 0,
          "title": "Inconclusive Count",
          "type": "integer"
        },
        "last_run_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
