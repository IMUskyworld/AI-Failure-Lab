        },
        "total_runs": {
          "default": 0,
          "title": "Total Runs",
          "type": "integer"
        }
      },
      "title": "Reproduction",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
