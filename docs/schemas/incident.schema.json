    },
    "harness": {
      "default": "unknown",
      "title": "Harness",
      "type": "string"
    },
    "model": {
      "default": "unknown",
      "title": "Model",
      "type": "string"
    },
    "occurrences": {
      "default": 1,
      "title": "Occurrences",
      "type": "integer"
    },
    "public_id": {
      "title": "Public Id",
      "type": "string"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "recovery": {
      "default": "",
      "title": "Recovery",
      "type": "string"
    },
    "reproduce": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReproSpec"
        },
        {
          "type": "null"
        }
