      },
      "title": "Recent",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ToolInfo"
    },
    "top_signatures": {
      "items": {
        "$ref": "#/$defs/TopSignature"
      },
      "title": "Top Signatures",
      "type": "array"
    },
